# Required: create an API key in the Anthropic Console.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sonnet is the quality/speed default. For lower-cost simple support traffic, try
# claude-haiku-4-5 after evaluating it against your test cases.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=900
CLAUDE_MAX_TOOL_ROUNDS=5
CLAUDE_TIMEOUT_SECONDS=45

# Optional: when set, clients must send this value in X-Support-API-Key.
SUPPORT_API_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
